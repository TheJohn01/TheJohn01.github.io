---
// Projeto em destaque na página inicial: arte e principais resultados (campo caseStudy do Markdown).
// O texto completo está na página do projeto.
import type { CollectionEntry } from 'astro:content';
import AsciiArt from './AsciiArt.astro';
import Findings from './Findings.astro';
import Label from './ui/Label.astro';
import StatusTag from './ui/StatusTag.astro';
import { hasBody } from '../lib/text';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { data, id, body } = Astro.props.project;
const study = data.caseStudy;
if (!study) throw new Error(`O projeto "${id}" não tem o campo caseStudy.`);
const page = hasBody(body) ? `/projetos/${id}/` : undefined;
---

<article class="case rv lift">
  <div class="meta-row">
    <Label text={data.tags.join(' · ')} />
    <StatusTag status={data.status} />
  </div>
  <div class="case-split">
    <div class="case-side">
      <h3 class="case-title">{data.title}</h3>
      <p class="lede">{data.summary}</p>
      {
        (page || data.links.length > 0) && (
          <div class="case-links">
            {page && <a href={page} class="more">Ler mais →</a>}
            {data.links.map((link) => <a href={link.href} class="more">{link.label} →</a>)}
          </div>
        )
      }
    </div>
    <div class="art-hover case-art well art-frame">
      <AsciiArt name={data.art} label={data.artLabel} size={5.8} />
    </div>
  </div>

  <div class="case-results">
    <Findings findings={study.findings} />
  </div>
</article>
