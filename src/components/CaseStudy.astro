---
// Projeto em destaque, em formato de caso de estudo (usa o campo caseStudy do Markdown).
import type { CollectionEntry } from 'astro:content';
import AsciiArt from './AsciiArt.astro';
import Label from './ui/Label.astro';
import StatusTag from './ui/StatusTag.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { data, id } = Astro.props.project;
const study = data.caseStudy;
if (!study) throw new Error(`O projeto "${id}" não tem o campo caseStudy.`);
---

<article class="case rv lift">
  <div class="meta-row">
    <Label text={data.tags.join(' · ')} />
    <StatusTag status={data.status} />
  </div>
  <h3 class="case-title">{data.title}</h3>
  <p class="lede">{data.summary}</p>

  <div class="case-split">
    <div class="art-hover case-art well art-frame">
      <AsciiArt name={data.art} label={data.artLabel} size={6.2} />
    </div>
    <div class="case-steps">
      <Label text="Como funciona" />
      <ol class="list">{study.howItWorks.map((step) => <li>{step}</li>)}</ol>
    </div>
  </div>

  <Label text="O que descobri" class="findings-label" />
  <div class="findings">
    {
      study.findings.map((finding) => (
        <div class="finding well">
          <div class="finding-value">{finding.value}</div>
          <div class="finding-text">{finding.text}</div>
        </div>
      ))
    }
  </div>

  <div class="case-cols">
    <div>
      <Label text="Como o validei" />
      <ul class="list">{study.validation.map((item) => <li>{item}</li>)}</ul>
    </div>
    <div>
      <Label text="O que ainda não está bem" />
      <ul class="list">{study.limitations.map((item) => <li>{item}</li>)}</ul>
    </div>
  </div>

  {
    study.technical.length > 0 && (
      <details class="details well">
        <summary>Detalhes técnicos</summary>
        <ul class="list">{study.technical.map((item) => <li>{item}</li>)}</ul>
      </details>
    )
  }

  {
    data.links.length > 0 && (
      <div class="case-links">
        {data.links.map((link) => <a href={link.href} class="more">{link.label} →</a>)}
      </div>
    )
  }
</article>
