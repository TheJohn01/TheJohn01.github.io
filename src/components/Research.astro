---
// Secção "Investigação": a publicação mais recente que tenha o campo highlight.
import { getCollection } from 'astro:content';
import { hasBody, inlineItalic } from '../lib/text';
import AsciiArt from './AsciiArt.astro';
import Label from './ui/Label.astro';

const publications = (await getCollection('publications'))
  .filter((entry) => entry.data.highlight)
  .sort((a, b) => b.data.year - a.data.year);
const entry = publications[0];
const pub = entry?.data;
const page = entry && hasBody(entry.body) ? `/publicacoes/${entry.id}/` : undefined;
const highlight = pub?.highlight;
---

{
  pub && highlight && (
    <section id="research" class="section research rv">
      <div class="research-copy">
        <Label text="Investigação" class="inherit" />
        <h2 class="h2">{highlight.heading}</h2>
        <p class="research-lede" set:html={inlineItalic(highlight.lede)} />
        <p class="citation">
          <i>{pub.title}.</i> {pub.journal}, {pub.issue}.
        </p>
        <div class="actions">
          {page && <a href={page} class="btn sm btn-primary">Ler mais</a>}
          <a href={pub.doi} class="btn sm btn-secondary">Ler o artigo</a>
        </div>
      </div>
      <div class="art-hover wine-art">
        <AsciiArt name={highlight.art} label={highlight.artLabel} lightOnly />
      </div>
    </section>
  )
}
