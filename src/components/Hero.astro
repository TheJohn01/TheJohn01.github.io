---
// Apresentação no topo da página, com as gotas ASCII à direita.
import { hero } from '../data/home';
import { person } from '../data/site';
import { caps } from '../lib/text';
import AsciiArt from './AsciiArt.astro';
---

<section id="top" class="hero wash">
  <div aria-hidden="true" class="par par-1">
    <div class="drop drop-1 bob"><div class="glint"></div></div>
  </div>
  <div aria-hidden="true" class="par par-2">
    <div class="drop drop-2 bob bob2"><div class="glint"></div></div>
  </div>
  <div aria-hidden="true" class="par par-3">
    <div class="drop drop-3 bob bob3"></div>
  </div>

  <div class="hero-panel enter">
    <div class="hero-copy">
      <div class="chip"><span aria-hidden="true" class="chip-dot sun"></span>{caps(hero.chip)}</div>
      <h1 class="display">{hero.title}</h1>
      <p class="hero-intro">{hero.intro}</p>
      <div class="actions">
        <a href="/#work" class="btn btn-primary">Ver projetos</a>
        <a href={person.cv.href} download={person.cv.filename} class="btn btn-secondary">Descarregar CV</a>
      </div>
    </div>
    <div class="art-hover hero-art">
      <AsciiArt name="hero" label={hero.artLabel} tones />
    </div>
  </div>
</section>
